{
  "name": "veo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,agent -c cyan,magenta \"vite\" \"npm:agent\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && npm run typecheck --workspace agent",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "dev:web": "vite",
    "agent": "tsx agent/src/main.ts",
    "test:agent": "npm run test --workspace agent",
    "test:all": "npm run test && npm run test:agent"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "concurrently": "^9.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "description": "Veo — a Messages client for the web, with a durable personal agent living inside it.",
  "workspaces": [
    "agent"
  ]
}
