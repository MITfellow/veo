{
  "name": "Veo",
  "short_name": "Veo",
  "description": "Veo is a personal agent that runs on your own device: it remembers what you tell it, asks before it acts, shows its working, and forgets on command. Everything stays on your device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#f6f6f6",
  "categories": [
    "social",
    "productivity"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New conversation",
      "short_name": "New",
      "url": "/?compose=1",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "file_handlers": [
    {
      "action": "/?open=1",
      "name": "Media and documents",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".webp",
          ".avif",
          ".bmp",
          ".svg",
          ".heic"
        ],
        "video/*": [
          ".mp4",
          ".m4v",
          ".mov",
          ".webm",
          ".mkv"
        ],
        "audio/*": [
          ".mp3",
          ".wav",
          ".m4a",
          ".aac",
          ".ogg",
          ".opus",
          ".flac"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "text/plain": [
          ".txt",
          ".md",
          ".csv",
          ".log"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "screenshots": [
    {
      "src": "/screenshots/thread.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "A conversation with photos, tapbacks and effects"
    },
    {
      "src": "/screenshots/camera.png",
      "sizes": "560x543",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Take a photo without leaving the thread"
    }
  ]
}
